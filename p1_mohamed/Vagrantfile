
nodes = [
  { name: "mmondads",  ip: "192.168.56.110", script: "scripts/server.sh" },
  { name: "mmondadsw", ip: "192.168.56.111", script: "scripts/worker.sh" }
]

Vagrant.configure("2") do |config|
  nodes.each do |node|
    config.vm.define node[:name] do |server|
      server.vm.box = "ubuntu/jammy64"
      server.vm.hostname = node[:name]
      server.vm.network "private_network", ip: node[:ip]

      server.vm.provider "virtualbox" do |v|
        v.name = node[:name]
        v.memory = 1024
        v.cpus = 1
      end

      server.vm.provision "shell", path: node[:script]
    end
  end
end
