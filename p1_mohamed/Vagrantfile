nodes = [
  { name: "mmondads",  ip: "192.168.56.110" },
  { name: "mmondadsw", ip: "192.168.56.111" }
]

Vagrant.configure("2") do |config|
  nodes.each do |node|
    config.vm.define node[:name] do |server|
      server.vm.box = "bento/centos-7"
      server.vm.hostname = node[:name]
      server.vm.network "private_network", ip: node[:ip]

      server.vm.provider "virtualbox" do |v|
        v.name = node[:name]
        v.memory = 1024
        v.cpus = 1
      end
    end
  end
end